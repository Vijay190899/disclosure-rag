# Copy to .env and fill in. Never commit the real .env.
# Nested settings use a double underscore, for example RETRIEVAL__TOP_K.

# Generation provider. Not needed to run the health endpoint or the spike.
OPENAI_API_KEY=

# Vector store
QDRANT__URL=http://localhost:6333
QDRANT__COLLECTION=disclosure_passages

# Ingestion
INGEST__RENDER_DPI=200
INGEST__TARGET_CHUNK_TOKENS=600
INGEST__CHUNK_OVERLAP_TOKENS=80

# Retrieval
RETRIEVAL__TOP_K=10
RETRIEVAL__CANDIDATE_K=50
RETRIEVAL__RRF_K=60
RETRIEVAL__RERANK_ENABLED=true

# Answering
ANSWER__ABSTAIN_BELOW=0.5
ANSWER__MAX_CONTEXT_CHUNKS=8

# Runtime
LOG_LEVEL=INFO
ENVIRONMENT=local

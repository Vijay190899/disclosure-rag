# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environments
.venv/
venv/
.env
.env.*
!.env.example

# uv
.uv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Data & models (keep large/private artifacts out of git)
data/
*.pdf
*.parquet
qdrant_storage/
models/

# The committed screenshot is documentation, not a build artefact.
!docs/images/**

# Test fixtures are the exception: cached parse output and small sample pages
# are committed so the chunker is testable offline, without network or keys.
!tests/fixtures/**

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
